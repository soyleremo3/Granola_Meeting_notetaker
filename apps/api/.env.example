# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- Storage ---
DATABASE_URL=sqlite:///./data/granola.db
STORAGE_DIR=./storage

# --- Transcription (local, free) ---
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=tr

# --- AI analysis (OpenRouter, free tier model) ---
# Leave empty to run in local-fallback-only mode (no external calls).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Master switch: set to false to fully disable external AI calls.
ENABLE_EXTERNAL_AI=true

# --- Uploads ---
# Maximum upload size in MB. 0 = no application-level limit (uploads are always
# streamed to disk in chunks, never held fully in memory, regardless of this value).
MAX_UPLOAD_SIZE_MB=0
