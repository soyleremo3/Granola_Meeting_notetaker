{
  "manifest_version": 3,
  "name": "Not Defteri Toplantı Kaydedici",
  "version": "0.1.0",
  "description": "Google Meet ve Zoom Web toplantılarını tek tıkla kaydedip yerel Not Defteri sunucusuna yükler.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Not Defteri Kaydedici"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["tabCapture", "offscreen", "storage", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "http://localhost:3000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/meet-content.js"],
      "css": ["content/banner.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.zoom.us/*"],
      "js": ["content/zoom-content.js"],
      "css": ["content/banner.css"],
      "run_at": "document_idle"
    }
  ]
}
